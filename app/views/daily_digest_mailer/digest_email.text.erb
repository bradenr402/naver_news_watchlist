<%= @title %>
<% @sections.each_with_index do |section, index| %>
<%= "\n\n---\n\n" if index.positive? %>
<%= results_count = section[:items].size %> results for "<%= section[:query] %>" (device: <%= section.fetch(:device, 'desktop') %>, sort: <%= DailyWatchlistJob::SORT_MAP.key(section.fetch(:sort_by, 0)).to_s.titleize %>, period: <%= DailyWatchlistJob::PERIOD_MAP[section.fetch(:period, '1d')] %>)<%= results_count.positive? ? ':' : '.' %>

<% if section[:items].any? %>
<% section[:items].each do |item| %>
<%= item[:position] %>) "<%= item[:title] %>"
    Date:    <%= item[:news_date] %>
    Link:    <%= item[:link] %>
    <% if item[:press_name].present? || item[:press_link].present? %>
    Source:  <%= item[:press_name].presence %><%= item[:press_link].present? ? " (#{item[:press_link]})" : "" %>
    <% end %>
    <%= "Snippet: \"#{item[:snippet]}\"" if item[:snippet].present? %>

<% end %>
<% end %>
<% end %>
